FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 5.0e-07;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 5.0e-07;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 5.0e-07;
        value           uniform 5.0e-07;
    }

    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }

    "(frontAndBack|defaultFaces)"
    {
        type            empty;
    }
}

